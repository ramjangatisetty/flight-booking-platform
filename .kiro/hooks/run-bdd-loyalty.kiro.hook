{
  "name": "Run BDD Tests - Loyalty",
  "version": "1.0.0",
  "description": "Manually generate BDD tests for Loyalty Service (SOAP).",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Follow .kiro/agents/gen-bdd-tests.md with SERVICE=loyalty-service MODE=delta to generate or update Cucumber feature files and step definitions for Loyalty Service (SOAP)."
  }
}
