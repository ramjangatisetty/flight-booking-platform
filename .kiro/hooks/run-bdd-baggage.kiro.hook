{
  "name": "Run BDD Tests - Baggage",
  "version": "1.0.0",
  "description": "Manually generate BDD tests for Baggage Service (XML REST).",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Follow .kiro/agents/gen-bdd-tests.md with SERVICE=baggage-service MODE=delta to generate or update Cucumber feature files and step definitions for Baggage Service (XML REST)."
  }
}
